# ============================================================================
# Casper Network MCP Server - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# CSPR.cloud API Configuration (REQUIRED for data API tools)
# ----------------------------------------------------------------------------
# Get your API key from https://cspr.cloud
# Required for: deploy tracking, NFT queries, validator data, transfer history
CSPR_CLOUD_API_KEY=your-api-key-here

# ----------------------------------------------------------------------------
# Casper Network Configuration
# ----------------------------------------------------------------------------
# Network to connect to: "testnet" or "mainnet"
CASPER_NETWORK=testnet

# RPC endpoint URL (optional - defaults to cspr.cloud hosted node)
# Testnet default: https://node.testnet.cspr.cloud/rpc
# Mainnet default: https://node.cspr.cloud/rpc
# Alternative testnet: https://rpc.testnet.casperlabs.io/rpc
# Alternative mainnet: https://rpc.mainnet.casperlabs.io/rpc
# CASPER_RPC_URL=https://node.testnet.cspr.cloud/rpc

# ----------------------------------------------------------------------------
# MCP Server Transport Configuration
# ----------------------------------------------------------------------------
# Transport mode: "stdio" (for CLI) or "http" (for web dashboard)
MCP_TRANSPORT=http

# HTTP server port (only used when MCP_TRANSPORT=http)
MCP_HTTP_PORT=3001

# CORS origin for web dashboard (only used when MCP_TRANSPORT=http)
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# OpenAI API Configuration (for AI-powered features)
# ----------------------------------------------------------------------------
# Only needed if using OpenAI for chat functionality
# OPENAI_API_KEY=sk-your-openai-key-here

# ----------------------------------------------------------------------------
# Wallet Configuration (STDIO MODE ONLY - for CLI/Studio signing)
# ----------------------------------------------------------------------------
# Secret key for transaction signing in stdio mode
# ⚠️ SECURITY WARNING: Only use this in stdio mode (Claude Desktop / MCP Studio)
# NEVER use this in HTTP mode or expose it to web frontends!
# Web users should sign via CSPR.click wallet instead.
#
# Format: PEM or hex format
# - PEM: Multi-line format starting with -----BEGIN PRIVATE KEY-----
# - Hex: 64 characters for Ed25519 or 66 characters for Secp256k1
#
# Example (TESTNET ONLY - never use real keys here!):
# CASPER_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# CASPER_SECRET_KEY=

# ----------------------------------------------------------------------------
# Development Configuration
# ----------------------------------------------------------------------------
# Node environment
NODE_ENV=development

# Debug logging
# DEBUG=casper-mcp:*

# ----------------------------------------------------------------------------
