# CSPR.AI Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_USER=csprai
POSTGRES_PASSWORD=csprai_dev_password
POSTGRES_DB=csprai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Full connection URL (used by Drizzle ORM)
DATABASE_URL=postgresql://csprai:csprai_dev_password@localhost:5433/csprai

# =============================================================================
# CACHE (Redis)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# =============================================================================
# MCP SERVER
# =============================================================================
MCP_SERVER_URL=http://localhost:3001
MCP_TRANSPORT=http

# =============================================================================
# CASPER NETWORK
# =============================================================================
# Options: testnet, mainnet
CASPER_NETWORK=testnet

# RPC Endpoints
CASPER_TESTNET_RPC=https://node.testnet.cspr.cloud/rpc
CASPER_MAINNET_RPC=https://node.cspr.cloud/rpc

# =============================================================================
# AI PROVIDERS
# =============================================================================
# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (optional, for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# DEVELOPMENT
# =============================================================================
NODE_ENV=development

# Debug mode for MCP server
MCP_DEBUG=false

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
