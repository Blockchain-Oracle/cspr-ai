# MCP Server Configuration
# URL of the MCP server's HTTP transport
# Local: http://localhost:3001
# Production: https://mcp.cspr-ai.xyz
NEXT_PUBLIC_MCP_SERVER_URL=https://mcp.cspr-ai.xyz
MCP_SERVER_URL=https://mcp.cspr-ai.xyz/mcp

# CSPR.click Configuration
# Get your app ID from https://cspr.click
# Use 'csprclick-template' for localhost development only
NEXT_PUBLIC_CSPRCLICK_APP_ID=csprclick-template

# Database Configuration (Neon PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
