# MCP Server Configuration
# URL of the MCP server's HTTP transport (include /mcp path)
# Local: http://localhost:3001/mcp
# Production: https://mcp.cspr-ai.xyz/mcp
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:3001/mcp

# CSPR.click Configuration
# Get your app ID from https://cspr.click
# Use 'csprclick-template' for localhost development only
NEXT_PUBLIC_CSPRCLICK_APP_ID=csprclick-template

# Database Configuration (Neon PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
# Required for voice integration (Realtime API)
OPENAI_API_KEY=sk-proj-...
